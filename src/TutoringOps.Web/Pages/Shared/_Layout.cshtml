@{
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var isParentPage = currentPath.StartsWith("/Status", StringComparison.OrdinalIgnoreCase);

    string NavClass(string page) =>
        currentPath.StartsWith(page, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &middot; Tutoring Operations</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-page="/Index">SAT Tutoring Ops</a>
        @if (!isParentPage)
        {
            <nav>
                <a asp-page="/Schedule" class="@NavClass("/Schedule")">Schedule</a>
                <a asp-page="/Students" class="@NavClass("/Students")">Students</a>
                <a asp-page="/Status" class="@NavClass("/Status")">Parent view</a>
            </nav>
        }
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        Business rules live in Oracle PL/SQL. This page only asks.
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
