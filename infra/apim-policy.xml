<!--
  API-level policy for the tutoring API behind APIM.

  Deliberately one policy. The goal is to convert APIM from "unknown" to "used"
  with something real, not to build a gateway configuration nobody maintains.

  IMPORTANT, and the thing that catches people out: which rate-limit element
  the Consumption tier accepts has FLIPPED over the years. The old guidance
  (and an earlier version of this file) said Consumption supports only
  rate-limit-by-key. As of Aug 2026 the gateway rejects rate-limit-by-key and
  quota-by-key with "Policy is not allowed in 'Consumption' sku" and accepts
  plain rate-limit; verified empirically against a live instance, because the
  documentation and the validator disagreed. If this fails validation after
  some future platform change, try the other one.

  (Note for anyone editing these comments: XML forbids a double hyphen inside a
  comment, and the management API rejects the whole policy when one appears.)
-->
<policies>
  <inbound>
    <base />

    <!--
      60 calls a minute, counted per subscription.

      The business books a handful of sessions a day, so this is nowhere near a
      real ceiling for legitimate use. It exists to make a runaway client or a
      loop in a script visible and bounded, not to shape traffic. Raise it
      freely; the point is that the limit exists and is enforced at the edge
      rather than in application code.
    -->
    <rate-limit calls="60" renewal-period="60" retry-after-header-name="Retry-After" />

    <!--
      Tells the backend which gateway a request arrived through. The API does
      not currently read this. It is here so that "only accept traffic via
      APIM" becomes a one-line change in the API rather than a redesign, should
      the Web App ever need to stop answering direct calls.
    -->
    <set-header name="X-Forwarded-By" exists-action="override">
      <value>apim</value>
    </set-header>

    <!--
      The backend requires this key on everything but /health and /swagger
      since real student data entered the system. The gateway authenticates to
      the backend so callers only ever need their APIM subscription key; the
      value lives in a secret named value, never in this file.
    -->
    <set-header name="X-Ops-Key" exists-action="override">
      <value>{{ops-api-key}}</value>
    </set-header>
  </inbound>

  <backend>
    <base />
  </backend>

  <outbound>
    <base />
    <!-- Do not advertise the backend stack to callers. -->
    <set-header name="X-Powered-By" exists-action="delete" />
    <set-header name="Server" exists-action="delete" />
  </outbound>

  <on-error>
    <base />
  </on-error>
</policies>
